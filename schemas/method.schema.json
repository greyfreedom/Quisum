{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/method.schema.json",
  "title": "Quisum method manifest projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "purposes",
    "requires",
    "files",
    "review",
    "license"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "purposes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streaming", "structured_output", "tool_use"],
      "properties": {
        "streaming": {"type": "boolean"},
        "structured_output": {"type": "boolean"},
        "tool_use": {"type": "boolean"}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facilitator", "output_schema", "memory_policy", "safety", "examples", "evals"],
      "properties": {
        "facilitator": {"const": "facilitator.md"},
        "output_schema": {"const": "output.schema.json"},
        "memory_policy": {"const": "memory-policy.yaml"},
        "safety": {"const": "safety.md"},
        "examples": {"const": "examples.jsonl"},
        "evals": {"const": "evals/cases.jsonl"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_at", "reviewer"],
      "properties": {
        "status": {"type": "string", "enum": ["unreviewed", "internal", "professional"]},
        "reviewed_at": {
          "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
        },
        "reviewer": {
          "oneOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]
        }
      }
    },
    "license": {"type": "string", "enum": ["Apache-2.0"]}
  }
}
