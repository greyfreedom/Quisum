{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/message.schema.json",
  "title": "Quisum session message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session_id",
    "role",
    "content",
    "created_at",
    "sensitivity",
    "crisis_related",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "session_id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120000
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "sensitivity": {
      "$ref": "common.schema.json#/$defs/sensitivity"
    },
    "crisis_related": {
      "type": "boolean"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    }
  }
}
