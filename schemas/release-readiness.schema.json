{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/release-readiness.schema.json",
  "title": "Quisum release readiness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "release_version",
    "release_channel",
    "updated_at",
    "summary",
    "gates"
  ],
  "properties": {
    "$schema": {"const": "../schemas/release-readiness.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "release_version": {
      "type": "string",
      "pattern": "^1\\.0\\.0(?:-rc\\.[1-9][0-9]*)?$"
    },
    "release_channel": {
      "type": "string",
      "enum": ["release-candidate", "stable"]
    },
    "updated_at": {"type": "string", "format": "date"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required_for_stable", "evidence", "note"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {"type": "string", "enum": ["open", "complete"]},
          "required_for_stable": {"type": "boolean"},
          "evidence": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 500},
              {"type": "null"}
            ]
          },
          "note": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
