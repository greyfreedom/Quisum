{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/open-question.schema.json",
  "title": "Quisum open question",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "question", "status", "contexts", "related_claims", "sensitivity", "crisis_related", "created_at", "source"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "common.schema.json#/$defs/entityId"},
    "question": {"$ref": "common.schema.json#/$defs/boundedText"},
    "status": {"type": "string", "enum": ["proposed", "open", "answered", "closed", "deleted"]},
    "contexts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/topic"}
    },
    "related_claims": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/entityId"}
    },
    "sensitivity": {"$ref": "common.schema.json#/$defs/sensitivity"},
    "crisis_related": {"type": "boolean"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "source": {"$ref": "common.schema.json#/$defs/source"}
  }
}
