{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/event.schema.json",
  "title": "Quisum event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "occurred_at",
    "recorded_at",
    "facts",
    "interpretations",
    "emotions",
    "bodily_responses",
    "actions",
    "short_term_outcomes",
    "long_term_outcomes",
    "topics",
    "sensitivity",
    "crisis_related",
    "source"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "common.schema.json#/$defs/entityId"},
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "confirmed", "rejected", "deleted"]
    },
    "occurred_at": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "common.schema.json#/$defs/boundedText"}
    },
    "interpretations": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/boundedText"}
    },
    "emotions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/topic"}
    },
    "bodily_responses": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/boundedText"}
    },
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/boundedText"}
    },
    "short_term_outcomes": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/boundedText"}
    },
    "long_term_outcomes": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/boundedText"}
    },
    "topics": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/topic"}
    },
    "sensitivity": {"$ref": "common.schema.json#/$defs/sensitivity"},
    "crisis_related": {"type": "boolean"},
    "source": {"$ref": "common.schema.json#/$defs/source"}
  }
}
