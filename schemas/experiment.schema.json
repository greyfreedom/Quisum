{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/experiment.schema.json",
  "title": "Quisum behavioral experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "hypothesis",
    "prediction",
    "action",
    "risk_level",
    "status",
    "related_claims",
    "planned_at",
    "completed_at",
    "expected_result",
    "actual_result",
    "learning",
    "sensitivity",
    "crisis_related",
    "source"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "common.schema.json#/$defs/entityId"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "hypothesis": {"$ref": "common.schema.json#/$defs/boundedText"},
    "prediction": {"$ref": "common.schema.json#/$defs/boundedText"},
    "action": {"$ref": "common.schema.json#/$defs/boundedText"},
    "risk_level": {"type": "string", "enum": ["low", "moderate"]},
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "completed", "cancelled", "deleted"]
    },
    "related_claims": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/entityId"}
    },
    "planned_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "completed_at": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "expected_result": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/boundedText"},
        {"type": "null"}
      ]
    },
    "actual_result": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/boundedText"},
        {"type": "null"}
      ]
    },
    "learning": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/boundedText"},
        {"type": "null"}
      ]
    },
    "sensitivity": {"$ref": "common.schema.json#/$defs/sensitivity"},
    "crisis_related": {"type": "boolean"},
    "source": {"$ref": "common.schema.json#/$defs/source"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "completed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "actual_result": {"$ref": "common.schema.json#/$defs/boundedText"},
          "learning": {"$ref": "common.schema.json#/$defs/boundedText"}
        }
      }
    }
  ]
}
