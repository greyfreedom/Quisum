{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/claim.schema.json",
  "title": "Quisum claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "statement",
    "status",
    "contexts",
    "supporting_evidence",
    "counterevidence",
    "alternative_explanations",
    "evidence_grade",
    "user_endorsement",
    "sensitivity",
    "source",
    "created_at",
    "updated_at",
    "supersedes",
    "crisis_related"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "common.schema.json#/$defs/entityId"},
    "kind": {
      "type": "string",
      "enum": [
        "explicit_fact",
        "user_self_assessment",
        "current_state",
        "value",
        "strength",
        "need_or_boundary",
        "pattern_hypothesis",
        "confirmed_insight"
      ]
    },
    "statement": {"$ref": "common.schema.json#/$defs/boundedText"},
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "pending_review",
        "confirmed",
        "revised",
        "uncertain",
        "rejected",
        "contradicted",
        "superseded",
        "deprecated",
        "deleted"
      ]
    },
    "contexts": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/topic"}
    },
    "supporting_evidence": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/entityId"}
    },
    "counterevidence": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/entityId"}
    },
    "alternative_explanations": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "evidence_grade": {
      "type": "string",
      "enum": ["limited", "moderate", "repeated", "contested"]
    },
    "user_endorsement": {
      "type": ["string", "null"],
      "enum": [null, "accepted", "edited", "uncertain", "rejected"]
    },
    "sensitivity": {"$ref": "common.schema.json#/$defs/sensitivity"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "revisit_after": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "supersedes": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/entityId"},
        {"type": "null"}
      ]
    },
    "crisis_related": {"type": "boolean", "default": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {"const": "pattern_hypothesis"}
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "alternative_explanations": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "confirmed"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "user_endorsement": {"enum": ["accepted", "edited"]}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "uncertain"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"user_endorsement": {"const": "uncertain"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "rejected"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"user_endorsement": {"const": "rejected"}}
      }
    },
    {
      "if": {
        "properties": {"kind": {"const": "current_state"}},
        "required": ["kind"]
      },
      "then": {
        "required": ["revisit_after"],
        "properties": {
          "revisit_after": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    }
  ]
}
