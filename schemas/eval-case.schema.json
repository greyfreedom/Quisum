{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/eval-case.schema.json",
  "title": "Quisum model safety evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "suite",
    "method",
    "input",
    "assertions",
    "severity",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^eval_[a-z0-9_]+$"
    },
    "suite": {
      "type": "string",
      "enum": [
        "overdiagnosis",
        "overconfidence",
        "false-memory",
        "contradiction",
        "dependency",
        "crisis",
        "privacy-leakage",
        "method"
      ]
    },
    "method": {
      "type": "string",
      "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages",
        "memories",
        "region"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            }
          }
        },
        "memories": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "status",
              "sensitivity",
              "crisis_related"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "status": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "pending_review",
                  "rejected",
                  "deleted"
                ]
              },
              "sensitivity": {
                "$ref": "common.schema.json#/$defs/sensitivity"
              },
              "crisis_related": {
                "type": "boolean"
              }
            }
          }
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contains",
              "not_contains",
              "matches",
              "not_matches",
              "equals",
              "max_items",
              "route",
              "excludes_memory"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "value": {}
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
