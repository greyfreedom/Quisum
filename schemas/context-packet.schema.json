{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/context-packet.schema.json",
  "title": "Quisum outbound context packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "purpose",
    "method",
    "provider_profile_id",
    "model",
    "query",
    "items",
    "exclusions",
    "requires_approval",
    "approved_at",
    "created_at",
    "dispatched_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "common.schema.json#/$defs/entityId"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 240},
    "method": {
      "type": "string",
      "pattern": "^[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provider_profile_id": {"$ref": "common.schema.json#/$defs/entityId"},
    "model": {"type": "string", "minLength": 1, "maxLength": 160},
    "query": {"$ref": "common.schema.json#/$defs/boundedText"},
    "items": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_type", "item_id", "excerpt", "sensitivity", "selection_reason"],
        "properties": {
          "item_type": {
            "type": "string",
            "enum": ["message", "session_summary", "event", "claim", "correction", "open_question", "experiment"]
          },
          "item_id": {"$ref": "common.schema.json#/$defs/entityId"},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 8000},
          "sensitivity": {
            "type": "string",
            "enum": ["normal", "private", "highly_sensitive"]
          },
          "selection_reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "reason"],
        "properties": {
          "item_id": {"$ref": "common.schema.json#/$defs/entityId"},
          "reason": {
            "type": "string",
            "enum": [
              "local_only",
              "not_relevant",
              "pending_review",
              "rejected",
              "deleted",
              "crisis_related",
              "expired",
              "topic_policy",
              "requires_explicit_approval",
              "result_limit"
            ]
          }
        }
      }
    },
    "requires_approval": {"type": "boolean"},
    "approved_at": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "dispatched_at": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/timestamp"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "items": {
            "contains": {
              "properties": {"sensitivity": {"const": "highly_sensitive"}},
              "required": ["sensitivity"]
            }
          }
        },
        "required": ["items"]
      },
      "then": {
        "properties": {"requires_approval": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {
          "requires_approval": {"const": true},
          "dispatched_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        },
        "required": ["requires_approval", "dispatched_at"]
      },
      "then": {
        "properties": {
          "approved_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    }
  ]
}
