{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/export-manifest.schema.json",
  "title": "Quisum portable export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "product_version",
    "format",
    "encrypted",
    "created_at",
    "records_sha256",
    "record_counts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "export_id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "format": {
      "type": "string",
      "enum": [
        "json",
        "jsonl"
      ]
    },
    "encrypted": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "records_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_counts": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
