{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/crisis-resource-pack.schema.json",
  "title": "Quisum versioned crisis resource pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_version",
    "source_checked_at",
    "source_check_due",
    "limitations",
    "fallback",
    "regions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "pack_version": { "const": "1.0.0" },
    "source_checked_at": { "type": "string", "format": "date" },
    "source_check_due": { "type": "string", "format": "date" },
    "limitations": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "fallback": { "$ref": "#/$defs/region" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "aliases",
        "locale",
        "immediate_danger",
        "additional_support",
        "source_urls"
      ],
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^(DEFAULT|[A-Z]{2})$"
        },
        "aliases": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "locale": { "type": "string", "minLength": 1, "maxLength": 32 },
        "immediate_danger": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "additional_support": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000
        },
        "source_urls": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    }
  }
}
