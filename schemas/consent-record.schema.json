{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quisum.org/schemas/consent-record.schema.json",
  "title": "Quisum consent record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "scope",
    "decision",
    "reason",
    "expires_at",
    "created_at",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/entityId"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "topic",
            "sensitivity",
            "provider",
            "context_packet",
            "plaintext_export"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "grant",
        "revoke",
        "grant_once"
      ]
    },
    "reason": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "source": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/source"
        },
        {
          "properties": {
            "actor": {
              "const": "user"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "grant_once"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "expires_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      }
    }
  ]
}
